# =============================================================================
# Frontend Client — demo environment (single-server deployment)
# =============================================================================
#   cp frontend-client/.env.demo.example frontend-client/.env.demo
# .env.demo is git-ignored.
# =============================================================================

NODE_ENV=production

# Server-side target for the Next.js /api/* rewrite (compose-internal DNS).
BACKEND_URL=http://backend:4000

# Baked at build time (=/api, same-origin). Runtime value has no effect.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_ADMIN_URL=https://admin.crystolia.com
