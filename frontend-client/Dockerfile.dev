# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 Crystolia Frontend - Development Dockerfile  
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Purpose: Hot-reload development environment for Next.js
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy config files (needed for Next.js)
COPY next.config.ts ./
COPY tsconfig.json ./
COPY postcss.config.mjs ./
COPY eslint.config.mjs ./

# Source code will be mounted as volume for hot reload
# No need to copy app/, components/, lib/ here

# Expose Next.js dev port
EXPOSE 3000

# Start Next.js dev server (has built-in hot reload)
CMD ["npm", "run", "dev"]
