# =============================================================================
# Compose-level demo environment
# =============================================================================
# Variables interpolated INTO docker-compose.demo.yml (image names, Caddy
# domains). Per-service runtime config lives in the *.env.demo files next to
# each service (backend/, frontend-admin/, frontend-client/).
#
#   cp deploy/demo/.env.demo.example deploy/demo/.env.demo
#
# Used as:  docker compose -f docker-compose.demo.yml --env-file deploy/demo/.env.demo ...
# .env.demo is git-ignored.
# =============================================================================

# ── Container images ─────────────────────────────────────────────────────────
# Registry namespace. GHCR example below; lowercase only.
IMAGE_PREFIX=ghcr.io/shaimullo
# Image tag to run. The demo-deploy workflow overrides this with the commit SHA
# via the shell environment; this value is the fallback default.
IMAGE_TAG=demo-latest

# ── Public domains (Caddy virtual hosts) ─────────────────────────────────────
CLIENT_DOMAIN=crystolia.com
ADMIN_DOMAIN=admin.crystolia.com
API_DOMAIN=api.crystolia.com

# ── TLS ──────────────────────────────────────────────────────────────────────
# Email for Let's Encrypt registration / expiry notices.
ACME_EMAIL=admin@crystolia.com
