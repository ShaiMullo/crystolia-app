# =============================================================================
# Backend — demo environment (single-server deployment)
# =============================================================================
# Copy to backend/.env.demo on the server and fill in real values.
# .env.demo is git-ignored. NEVER commit real secrets.
#
#   cp backend/.env.demo.example backend/.env.demo
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000

# MongoDB. Recommended: MongoDB Atlas free tier (M0) — it is a real replica
# set, so Phase 7/8 transactions are atomic.
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/crystolia?retryWrites=true&w=majority
# For the bundled local Mongo (--profile local-mongo) use:
#   mongodb://mongo:27017/crystolia
MONGO_URI=mongodb+srv://CHANGE_ME

# Auth — generate a strong random value, e.g.  openssl rand -hex 32
# MUST be identical to JWT_SECRET in frontend-admin/.env.demo.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# ── URLs / CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://business.crystolia.com
ADMIN_FRONTEND_URL=https://admin.crystolia.com
# Comma-separated. UI traffic is same-origin via the Next /api rewrite, so this
# is a safety net for any direct cross-origin call + the landing site.
CORS_ALLOW_ORIGINS=https://business.crystolia.com,https://admin.crystolia.com,https://crystolia.com,https://www.crystolia.com
# Leave empty (host-only cookie). Set to .crystolia.com only if you need the
# auth cookie shared across subdomains.
COOKIE_DOMAIN=

# ── Scheduler (Phase 8) ──────────────────────────────────────────────────────
# Single backend container on the demo box ⇒ keep "true".
ENABLE_SCHEDULER=true

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.crystolia.com/api/auth/google/callback

# ── Green Invoice (optional — leave sandbox unless billing for real) ─────────
GREEN_INVOICE_API_ID=
GREEN_INVOICE_SECRET=
GREEN_INVOICE_SANDBOX=true

# ── WhatsApp / UltraMsg (optional) ───────────────────────────────────────────
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ADMIN_PHONE_NUMBER=

# Optional SMS notifications (Twilio). ADMIN_PHONE_NUMBER is the recipient.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Transactional email (Twilio SendGrid) ───────────────────────────────────
# Separate from the Twilio Messaging credentials above. Verify the sender or
# authenticate crystolia.com in SendGrid before enabling production delivery.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=admin@crystolia.com
EMAIL_FROM_NAME=Crystolia
EMAIL_REPLY_TO=admin@crystolia.com
