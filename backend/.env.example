# ===============================================
# 🔧 Crystolia Backend - Environment Variables
# ===============================================
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001

# Database
MONGO_URI=mongodb://localhost:27017/crystolia

# Security (REQUIRED — backend will not start without this)
JWT_SECRET=your-secret-here

# CORS (comma-separated origins — must include landing site for lead ingestion)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,https://crystolia.com,https://www.crystolia.com

# ─────────────────────────────────────────────
# 🔐 Google OAuth (optional in development)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production must use the same public business-portal host as the browser flow:
# https://business.crystolia.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─────────────────────────────────────────────
# 📱 WhatsApp - UltraMsg Provider
# ─────────────────────────────────────────────
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
ADMIN_PHONE_NUMBER=

# Optional SMS notifications (Twilio). ADMIN_PHONE_NUMBER is the recipient.
# TWILIO_MESSAGING_SERVICE_SID (MG…) sends via the Messaging Service that
# carries the "Crystolia" Alphanumeric Sender ID; it is preferred over
# TWILIO_PHONE_NUMBER when both are set. At least one of the two is required.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=

# Transactional email. Twilio Email is the default and reuses the Twilio
# credentials above. Set EMAIL_PROVIDER=sendgrid plus SENDGRID_API_KEY only
# for the legacy SendGrid API. EMAIL_FROM_ADDRESS must belong to an
# authenticated domain.
EMAIL_PROVIDER=twilio
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=admin@crystolia.com
EMAIL_FROM_NAME=Crystolia
EMAIL_REPLY_TO=admin@crystolia.com
