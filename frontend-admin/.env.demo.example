# =============================================================================
# Frontend Admin — demo environment (single-server deployment)
# =============================================================================
#   cp frontend-admin/.env.demo.example frontend-admin/.env.demo
# .env.demo is git-ignored.
# =============================================================================

NODE_ENV=production

# Server-side target for the Next.js /api/* rewrite. Inside the compose
# network the backend is reachable as http://backend:4000.
BACKEND_URL=http://backend:4000

# JWT secret — middleware.ts verifies the auth cookie with this.
# MUST be identical to JWT_SECRET in backend/.env.demo.
JWT_SECRET=CHANGE_ME_64_HEX_CHARS

# NEXT_PUBLIC_API_URL is baked at build time (=/api, same-origin). Listed here
# only for completeness; changing it at runtime has no effect.
NEXT_PUBLIC_API_URL=/api
