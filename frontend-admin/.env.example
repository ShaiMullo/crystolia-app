# ===============================================
# 🔧 Crystolia Frontend Admin - Environment Variables
# ===============================================
# Copy this file to .env.local and adjust if needed.
# .env.local is gitignored and is loaded automatically by `next dev`.

# Public base URL used by axios (`app/lib/api.ts` sets baseURL="/api",
# so this is informational unless you reference it directly).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side rewrite target for /api/* (see next.config.ts).
# Local dev:        http://localhost:4000
# Docker compose:   http://backend:4000  (set in docker-compose.*.yml)
# Staging/prod:     set to the internal backend URL of your environment
BACKEND_URL=http://localhost:4000

# JWT secret used by middleware.ts to verify the auth cookie locally.
# In local dev this MUST match the backend's JWT_SECRET (see backend/.env).
JWT_SECRET=dev-secret-for-local-testing
